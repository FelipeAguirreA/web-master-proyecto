generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  COMPANY
}

enum Modality {
  REMOTE
  ONSITE
  HYBRID
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum PipelineStatus {
  PENDING
  REVIEWING
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum ModuleType {
  SKILLS
  EXPERIENCE
  EDUCATION
  LANGUAGES
  PORTFOLIO
  CUSTOM
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MessageType {
  TEXT
  INTERVIEW
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  APPLICATION_REVIEWED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  NEW_APPLICATION
  NEW_MESSAGE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  lastName     String?
  rut          String?  @unique
  phone        String?
  role         Role
  image        String?
  provider     String?
  providerId   String?
  passwordHash  String?
  resetToken    String?   @unique
  resetTokenExp DateTime?
  consentAcceptedAt DateTime?
  consentVersion    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile StudentProfile?
  companyProfile CompanyProfile?
  applications   Application[]

  companyConversations Conversation[] @relation("CompanyConversations")
  studentConversations Conversation[] @relation("StudentConversations")
  sentMessages         Message[]
  companyInterviews    Interview[]    @relation("CompanyInterviews")
  studentInterviews    Interview[]    @relation("StudentInterviews")
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  savedInternships     SavedInternship[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  university String?
  career    String?
  semester  Int?
  skills    String[]
  bio       String?
  cvUrl     String?
  cvText    String?
  cvParsed  Json?
  embedding Float[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

model CompanyProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  empresaRut    String?
  companyStatus CompanyStatus @default(PENDING)
  suspensionReason String?
  suspendedAt   DateTime?
  industry      String?
  website       String?
  logo          String?
  description   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  internships Internship[]

  @@map("company_profiles")
}

model Internship {
  id           String    @id @default(cuid())
  companyId    String
  company      CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String
  area         String
  location     String
  modality     Modality
  duration     String
  responsibilities String[] @default([])
  requirements String[]
  skills       String[]
  embedding    Float[]
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications Application[]
  atsConfig    ATSConfig?
  interviews   Interview[]
  savedBy      SavedInternship[]

  @@index([isActive, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([deletedAt])
  @@map("internships")
}

// Wishlist del estudiante: prácticas marcadas para revisar después sin haber
// postulado todavía. Cardinalidad many-to-many entre User (rol STUDENT) e
// Internship. @@unique evita duplicados; el índice (studentId, createdAt desc)
// soporta el listado "mis guardadas" ordenado por más reciente.
model SavedInternship {
  id           String     @id @default(cuid())
  studentId    String
  internshipId String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([studentId, internshipId])
  @@index([studentId, createdAt(sort: Desc)])
  @@map("saved_internships")
}

model Application {
  id           String            @id @default(cuid())
  studentId    String
  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipId String
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  status         ApplicationStatus @default(PENDING)
  matchScore     Float?
  coverLetter    String?
  atsScore       Float?
  moduleScores   Json?
  passedFilters  Boolean        @default(true)
  filterReason   String?
  pipelineStatus PipelineStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  conversation Conversation?
  interview    Interview?

  @@unique([studentId, internshipId])
  @@index([internshipId])
  @@map("applications")
}

model ATSConfig {
  id           String      @id @default(cuid())
  internshipId String      @unique
  internship   Internship  @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  isActive     Boolean     @default(true)
  modules      ATSModule[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("ats_configs")
}

model ATSModule {
  id          String     @id @default(cuid())
  atsConfigId String
  atsConfig   ATSConfig  @relation(fields: [atsConfigId], references: [id], onDelete: Cascade)
  type        ModuleType
  label       String
  isActive    Boolean    @default(true)
  weight      Int
  order       Int
  params      Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([atsConfigId])
  @@map("ats_modules")
}

model Conversation {
  id                   String       @id @default(cuid())
  companyId            String
  studentId            String
  applicationId        String       @unique
  company              User         @relation("CompanyConversations", fields: [companyId], references: [id], onDelete: Cascade)
  student              User         @relation("StudentConversations", fields: [studentId], references: [id], onDelete: Cascade)
  application          Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages             Message[]
  interviews           Interview[]
  companyPinned        Boolean      @default(false)
  studentPinned        Boolean      @default(false)
  companyMarkedUnread  Boolean      @default(false)
  studentMarkedUnread  Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([companyId])
  @@index([studentId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  content        String       @db.Text
  type           MessageType  @default(TEXT)
  metadata       Json?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Interview {
  id             String          @id @default(cuid())
  companyId      String
  studentId      String
  internshipId   String
  applicationId  String          @unique
  conversationId String
  company        User            @relation("CompanyInterviews", fields: [companyId], references: [id], onDelete: Cascade)
  student        User            @relation("StudentInterviews", fields: [studentId], references: [id], onDelete: Cascade)
  internship     Internship      @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String
  scheduledAt    DateTime
  durationMins   Int             @default(60)
  meetingLink    String?
  notes          String?         @db.Text
  sentToChat     Boolean         @default(false)
  sentToChatAt   DateTime?
  status         InterviewStatus @default(SCHEDULED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([companyId])
  @@index([scheduledAt])
  @@map("interviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  entityId  String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// F-Legal-3.4: trazabilidad de eventos sensibles (creación/eliminación de
// cuenta, export de datos, decisiones admin). NO debe contener PII directa
// — `userId` queda nullable y `onDelete: SetNull` para que un borrado
// ARCO+ no haga desaparecer el evento de auditoría. `metadata` es Json
// para datos no-PII como `requestId`, IPs hasheadas, contexto técnico.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
