# ── Base de datos ──────────────────────────────────────────────────────────
# Supabase → Settings → Database → Transaction Pooler (puerto 6543).
# pgBouncer en modo transaction → soporta queries normales del Prisma Client
# en runtime, pero NO soporta todas las queries de prisma migrate / db push
# (por eso DIRECT_URL más abajo).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase → Settings → Database → Direct connection (puerto 5432).
# La usa la CLI de Prisma 7 (db push, migrate) — leída desde prisma.config.ts.
# Si no está, Prisma 7 CLI cae a DATABASE_URL como fallback.
# Opcional en dev local con Docker (compose expone una sola conexión directa).
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_KEY="eyJ..."

# ── NextAuth ───────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET requiere mínimo 32 chars (validado por Zod en src/lib/env.ts).
# Generar con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-min-32-chars-here"

# ── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"

# ── HuggingFace (opcional) ─────────────────────────────────────────────────
# Sin esto: matching usa embedding vacío gracefulmente (no rompe).
HUGGINGFACE_API_KEY="hf_xxxx"

# ── Brevo (opcional) ───────────────────────────────────────────────────────
# Sin esto: emails no se envían pero la app sigue funcionando.
BREVO_API_KEY="xkeysib-xxxx"
BREVO_SENDER_EMAIL="noreply@tudominio.com"

# ── Sentry (opcional) ──────────────────────────────────────────────────────
# Solo NEXT_PUBLIC_SENTRY_DSN se necesita en runtime / dev local.
# SENTRY_AUTH_TOKEN NO va acá — vive SOLO en Vercel project settings + GitHub
# Actions repo secrets (es un Org Auth Token con scope `org:ci` que sube
# sourcemaps en build). Tener un placeholder acá invita a leakearlo.
# `org` y `project` están hardcoded en next.config.ts (withSentryConfig wrapper).
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"

# ── Upstash Redis (opcional) ───────────────────────────────────────────────
# Sin esto: rate limit cae a un Map in-memory que NO funciona en Vercel
# multi-instancia (cada lambda tiene su propio Map → el límite efectivo se
# multiplica por la cantidad de instancias). En dev local el Map alcanza.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# ── Dev local con Docker (alternativa a Supabase) ──────────────────────────
# Si usás docker compose up para postgres local en vez de Supabase:
# DATABASE_URL="postgresql://practix:practix@localhost:5433/practix"
# DIRECT_URL="postgresql://practix:practix@localhost:5433/practix"
# El puerto del compose es 5433 (no 5432) para evitar choque con postgres
# del host si lo hubiera.
